DEVICE_ID=pi-prototype-001
SQLITE_PATH=./data/irrigation_pi.sqlite3

# Cloud API base URL. On a real deployment, use HTTPS.
CLOUD_API_URL=http://127.0.0.1:8000
DEVICE_TOKEN=dev-device-token-change-me

SAMPLE_INTERVAL_SECONDS=2.0
SYNC_INTERVAL_SECONDS=10.0
SYNC_BATCH_SIZE=100
SYNC_TIMEOUT_SECONDS=5.0
QUEUE_BACKLOG_ALERT_THRESHOLD=1000

# Source options:
# demo = synthetic data
# file = read latest telemetry JSON written by the existing control service
# csv = read latest row from the existing control service CSV log
# serial = read Nano serial directly; use only if no other service owns the port
TELEMETRY_SOURCE=demo
TELEMETRY_FILE=/var/lib/irrigation/latest_telemetry.json
CONTROL_CSV_GLOB=/home/alec-anderson23/irrigation_production_nano_*.csv

# Serial is optional and should not be used while the control service owns Nano serial.
# Example Raspberry Pi serial paths: /dev/ttyUSB0, /dev/ttyACM0
SERIAL_PORT=
SERIAL_BAUD=115200

# nano_csv parses your existing TEL,... and ANGLE:... Nano output.
# json parses newline-delimited JSON if you add that later.
SERIAL_PROTOCOL=nano_csv
