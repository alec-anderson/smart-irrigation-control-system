# For the simplest local run, leave SQLite as-is.
# For Postgres: postgresql+psycopg://irrigation:password@localhost:5432/irrigation
DATABASE_URL=sqlite:///./irrigation_backend_dev.sqlite3

# Comma-separated device_id:token pairs.
DEVICE_TOKENS=pi-prototype-001:dev-device-token-change-me

# Bearer token used by the static dashboard.
DASHBOARD_TOKEN=dev-dashboard-token-change-me

# Comma-separated allowed dashboard origins. Use * for a local Wi-Fi demo only.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

API_HOST=0.0.0.0
API_PORT=8000
